# --- Base de datos ---
# Cadena de conexión de PostgreSQL. Puede ser local, o de un proveedor
# gratuito/económico como Supabase, Neon o Railway.
DATABASE_URL="postgresql://usuario:password@localhost:5432/invitaciones?schema=public"

# --- Sesiones (panel de administración) ---
# Cadena aleatoria de al menos 32 caracteres. Genérala con:
#   openssl rand -hex 32
SESSION_SECRET="cambia-esto-por-una-cadena-aleatoria-larga-y-secreta"

# --- Google Sheets (sincronización de RSVPs) ---
# 1. Crea un proyecto en Google Cloud Console y habilita "Google Sheets API".
# 2. Crea una cuenta de servicio (Service Account) y descarga su JSON.
# 3. Comparte tu hoja de Google Sheets con el email de la cuenta de servicio
#    (con permiso de Editor).
# 4. Copia el ID de la hoja desde su URL:
#    https://docs.google.com/spreadsheets/d/ESTE_ES_EL_ID/edit
GOOGLE_SERVICE_ACCOUNT_EMAIL="tu-cuenta-de-servicio@tu-proyecto.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID="el-id-de-tu-hoja-de-calculo"
GOOGLE_SHEET_TAB="RSVPs"

# --- Email de respaldo con QR (Gmail) ---
# Cada invitado ve su(s) QR en pantalla al confirmar; este correo es solo
# un respaldo por si lo pierde, enviado desde tu propia cuenta de Gmail.
# 1. Activa la verificación en dos pasos en tu cuenta de Gmail:
#    https://myaccount.google.com/security
# 2. Genera una "contraseña de aplicación" (16 caracteres, distinta a tu
#    contraseña normal, hecha justo para que apps externas envíen correo
#    en tu nombre): https://myaccount.google.com/apppasswords
#    (elige app "Correo" y dispositivo "Otro", ponle un nombre como
#    "Sistema de invitaciones").
# 3. Copia esos 16 caracteres (sin espacios) como GMAIL_APP_PASSWORD.
GMAIL_USER="tunegocio@gmail.com"
GMAIL_APP_PASSWORD="xxxxxxxxxxxxxxxx"

# Opcional: a dónde te llega el aviso de "nueva respuesta" en cada RSVP.
# Si lo dejas vacío, te llega a la misma cuenta GMAIL_USER de arriba.
OWNER_NOTIFICATION_EMAIL="tucorreopersonal@gmail.com"

# --- Framer (CORS) ---
# El dominio exacto donde publiques tu invitación en Framer, para que el
# formulario pueda llamar a la API pública sin ser bloqueado por el
# navegador. Ejemplo: https://mi-invitacion.framer.website
# En desarrollo puedes dejarlo vacío (se usará "*", cualquier origen).
FRAMER_ALLOWED_ORIGIN="https://tu-sitio.framer.website"
